# Copier ce fichier en « .env » puis remplir les valeurs.
# Ne publie JAMAIS le fichier .env (il est ignoré par git).

# --- Discord -------------------------------------------------------------
# Portail : https://discord.com/developers/applications → ton app → Bot → Reset Token
DISCORD_TOKEN=
# Clic droit sur le serveur / salon / rôle → « Copier l'identifiant »
# (activer le Mode développeur : Paramètres → Avancés)
DISCORD_GUILD_ID=
# Salon privé de l'équipe où arrivent les dossiers
DISCORD_REPORTS_CHANNEL_ID=
# Salon où sont créés les fils privés d'aide
DISCORD_HELP_CHANNEL_ID=
# Rôle « Intervenant·e »
DISCORD_STAFF_ROLE_ID=

# --- Twitch (facultatif) -------------------------------------------------
TWITCH_ENABLED=false
# Console : https://dev.twitch.tv/console/apps
# URL de redirection OAuth à déclarer dans l'app : http://localhost:17563
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Chaînes à écouter, séparées par des virgules (noms de connexion)
TWITCH_CHANNELS=
TWITCH_TOKEN_PATH=data/twitch_token.json

# --- Général -------------------------------------------------------------
# Lien public donné aux gens (invitation Discord, formulaire…)
PUBLIC_HELP_URL=https://discord.gg/xxxxxxx
DATABASE_PATH=data/bot.sqlite3
# Les dossiers fermés sont supprimés après ce nombre de jours (Loi 25)
RETENTION_DAYS=90
# Nombre max de signalements / demandes par personne et par heure
REPORTS_PER_HOUR=5
LOG_LEVEL=INFO
