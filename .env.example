# Copier ce fichier en « .env » puis remplir les valeurs.
# Ne publie JAMAIS le fichier .env (il est ignoré par git).
# Chaque intégration (Discord, Twitch, extension, Google Sheets) s'active quand ses variables sont remplies.

# --- Adresses ---------------------------------------------------------------
# Adresse publique du service (sans / final). En production : https://...
BASE_URL=http://127.0.0.1:8000
# Où le bouton « Parler à un·e TRN » envoie les viewers (invitation Discord des TRN)
DESTINATION_URL=https://discord.gg/XXXXXXX

# --- Sécurité ---------------------------------------------------------------
# 32 caractères aléatoires ou plus :  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Page Web de secours /admin : « discord » (rôle TRN) ou « password » (essais)
AUTH_MODE=password
ADMIN_PASSWORD=

# --- Discord (serveur des TRN) ----------------------------------------------
# Application : https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Bot : onglet Bot → Reset Token
DISCORD_BOT_TOKEN=
# Clic droit → Copier l'identifiant (Mode développeur activé)
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=
# Salon où arrivent les demandes des chaînes
DISCORD_REQUESTS_CHANNEL_ID=

# --- Twitch (connexion des mods + bot de chat) -------------------------------
# Application : https://dev.twitch.tv/console/apps
#   OAuth Redirect URL : <BASE_URL>/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Clé pour autoriser le compte du bot une fois : <BASE_URL>/bot/autoriser?cle=<BOT_SETUP_KEY>
BOT_SETUP_KEY=

# --- Extension Twitch (facultatif) --------------------------------------------
# Console → Extensions → ton extension → Client ID et « Extension Secret »
EXTENSION_CLIENT_ID=
EXTENSION_SECRET=

# --- Google Sheets (journal des événements) ----------------------------------
# Voir integrations/google-sheets/README.md
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# --- Règles -------------------------------------------------------------------
# Délai entre deux demandes d'une même chaîne (minutes)
REQUEST_COOLDOWN_MINUTES=10
# Durée de la connexion Twitch des mods (jours) ; le statut de mod est revérifié à chaque demande
MOD_SESSION_DAYS=30
# Durée d'un statut « disponible » / « occupé » avant retour automatique à « hors ligne » (heures)
DEFAULT_DURATION_HOURS=4

# --- Contenu ------------------------------------------------------------------
ORG_NAME=Fondation des Gardiens virtuels
HOURS_TEXT=du lundi au vendredi, de 18 h à 23 h
TIMEZONE=America/Toronto

# --- Technique ----------------------------------------------------------------
DATABASE_PATH=data/acces_trn.sqlite3
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
