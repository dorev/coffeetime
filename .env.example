# Copier ce fichier en « .env » puis remplir les valeurs.
# Ne publie JAMAIS le fichier .env (il est ignoré par git).

# --- Adresses ---------------------------------------------------------------
# Adresse publique du service (sans / final). En production : https://...
BASE_URL=http://127.0.0.1:8000
# Où le bouton « Parler à un·e TRN » envoie les gens :
# invitation Discord du serveur des TRN (idéalement vers le salon des tickets)
DESTINATION_URL=https://discord.gg/XXXXXXX

# --- Sécurité ---------------------------------------------------------------
# 32 caractères aléatoires ou plus. Pour en générer :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Connexion de l'espace TRN : « discord » (recommandé) ou « password » (essais)
AUTH_MODE=password
# Mode password : mot de passe partagé de l'équipe (12 caractères minimum)
ADMIN_PASSWORD=
# Mode discord : application sur https://discord.com/developers/applications
#   OAuth2 → Redirects : <BASE_URL>/admin/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Serveur Discord des TRN et rôle autorisé (clic droit → Copier l'identifiant)
DISCORD_GUILD_ID=
DISCORD_ROLE_ID=

# --- Contenu ----------------------------------------------------------------
ORG_NAME=Fondation des Gardiens virtuels
HOURS_TEXT=du lundi au vendredi, de 18 h à 23 h
# Durée par défaut d'un statut « disponible » / « occupé » avant retour
# automatique à « hors ligne » (1 à 24 h)
DEFAULT_DURATION_HOURS=4
TIMEZONE=America/Toronto

# --- Technique --------------------------------------------------------------
DATABASE_PATH=data/acces_trn.sqlite3
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
