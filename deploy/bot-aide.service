# Service systemd (Linux) pour démarrer le bot automatiquement.
#
# Installation (service utilisateur, sans droits administrateur) :
#   1. Adapter WorkingDirectory et ExecStart ci-dessous.
#   2. mkdir -p ~/.config/systemd/user && cp deploy/bot-aide.service ~/.config/systemd/user/
#   3. systemctl --user daemon-reload && systemctl --user enable --now bot-aide
#   4. loginctl enable-linger $USER     # démarre même sans session ouverte
#   Journaux : journalctl --user -u bot-aide -f

[Unit]
Description=Bot d'aide et de signalement (Discord + Twitch)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/bot-aide
ExecStart=%h/bot-aide/.venv/bin/python -m bot_aide
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
